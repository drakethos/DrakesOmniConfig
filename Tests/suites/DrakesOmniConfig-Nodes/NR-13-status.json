{
  "name": "NR-13 status: equipping the mace gives Rested",
  "steps": [
    {
      "do": "give",
      "prefab": "MaceBronze",
      "count": 1
    },
    {
      "do": "hook",
      "name": "omniconfig.equip",
      "args": {
        "item": "MaceBronze"
      },
      "expect": true
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "hook",
      "name": "omniconfig.hasStatus",
      "args": {
        "effect": "Rested"
      },
      "expect": true
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "DrakesOmniConfig"
    }
  ]
}
