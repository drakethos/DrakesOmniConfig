<Project>
  <!-- environment.props is loaded by Jotunn Paths.props via SolutionDir (before Directory.Build continues). Do not Import it again here. -->
  <Import Project="$(MSBuildThisFileDirectory)mod.package.props" Condition="Exists('$(MSBuildThisFileDirectory)mod.package.props')" />
  <!-- CI checks out this repo alone — use NuGet net48 reference assemblies. -->
  <PropertyGroup Condition="'$(CI_NET48_FWPATH)' != ''">
    <TargetFrameworkRootPath>$(CI_NET48_FWPATH)/</TargetFrameworkRootPath>
  </PropertyGroup>
  <Import Project="$(CI_NET48_FWPATH)/Microsoft.NETFramework.ReferenceAssemblies.net48.targets"
          Condition="'$(CI_NET48_FWPATH)' != '' and Exists('$(CI_NET48_FWPATH)/Microsoft.NETFramework.ReferenceAssemblies.net48.targets')" />
  <PropertyGroup>
    <!-- Resolves to the repo-root build\ folder shared with the baseline project (sibling, one level up). -->
    <DrakeModBuildRoot Condition="Exists('$(MSBuildThisFileDirectory)..\build\DrakeMod.Build.props')">$(MSBuildThisFileDirectory)..\build\</DrakeModBuildRoot>
    <DrakeModBuildRoot Condition="'$(DrakeModBuildRoot)' == '' and Exists('$(MSBuildThisFileDirectory)build\DrakeMod.Build.props')">$(MSBuildThisFileDirectory)build\</DrakeModBuildRoot>
  </PropertyGroup>
  <Import Project="$(DrakeModBuildRoot)DrakeMod.Build.props" Condition="'$(DrakeModBuildRoot)' != ''" />
  <!-- No DrakeModsLibs / Jotunn dependency — plain BepInEx plugin, same as the baseline build. -->
</Project>
