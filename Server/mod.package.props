<Project>
  <PropertyGroup>
    <!-- Thunderstore/Hexium package id — do not rename after publish -->
    <ThunderstoreName>DrakesOmniConfigServer</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesOmniConfig</RootNamespace>
    <AssemblyName>DrakesOmniConfigServer</AssemblyName>
    <Version>0.1.0</Version>
    <!-- BepIn plugin display name — do not change (existing installs / docs) -->
    <BepInPluginName>DrakesOmniConfigServer</BepInPluginName>
    <BepInGuid>com.drakemods.omniconfigserver</BepInGuid>
    <ModInfoClass>DrakesOmniConfigServerPlugin</ModInfoClass>
    <Description>Server/admin build of DrakesOmniConfig: same engine, plus tools for building and testing modlets. Standalone — do not install alongside DrakesOmniConfig. Stub — not yet implemented.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesOmniConfig</WebsiteUrl>
  </PropertyGroup>
  <!-- Standalone, same as the baseline build: no dependency on DrakesOmniConfig itself, no Jotunn, no DrakeModsLibs. -->
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
  </ItemGroup>
</Project>
