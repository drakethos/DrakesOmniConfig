<Project>
  <PropertyGroup>
    <!-- Thunderstore/Hexium package id — do not rename after publish -->
    <ThunderstoreName>DrakesOmniConfig</ThunderstoreName>
    <ThunderstoreAuthor>DrakeMods</ThunderstoreAuthor>
    <RootNamespace>DrakesOmniConfig</RootNamespace>
    <AssemblyName>DrakesOmniConfig</AssemblyName>
    <Version>0.1.0</Version>
    <!-- BepIn plugin display name — do not change (existing installs / docs) -->
    <BepInPluginName>DrakesOmniConfig</BepInPluginName>
    <BepInGuid>com.drakemods.omniconfig</BepInGuid>
    <ModInfoClass>DrakesOmniConfigPlugin</ModInfoClass>
    <Description>Config anything in Valheim without the bs slow down etc. Stub — not yet implemented.</Description>
    <WebsiteUrl>https://github.com/drakethos/DrakesOmniConfig</WebsiteUrl>
  </PropertyGroup>
  <!-- No mod dependencies yet (no Jotunn, no DrakeModsLibs). Add ThunderstoreDependency entries here if that changes. -->
  <ItemGroup>
    <ThunderstoreDependency Include="denikson-BepInExPack_Valheim-5.4.2351" />
  </ItemGroup>
</Project>
